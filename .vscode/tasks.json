{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Watch All",
			"dependsOn": [
				"Watch & Deploy samsung-tv-art-uploader (python — restart container)",
				"Watch & Deploy samsung-tv-art-uploader (assets — no restart)",
				"Watch & Deploy samsung-tv-art-card"
			],
			"dependsOrder": "parallel",
			"problemMatcher": [],
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"label": "Watch & Deploy samsung-tv-art-uploader",
			"dependsOn": [
				"Watch & Deploy samsung-tv-art-uploader (python — restart container)",
				"Watch & Deploy samsung-tv-art-uploader (assets — no restart)"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},
		{
			"label": "Watch & Deploy samsung-tv-art-uploader (python — restart container)",
			"type": "process",
			"command": "python3",
			"windows": {
				"command": "python"
			},
			"args": [
				"scripts/watch_deploy.py",
				"--label", "python",
				"--host", "${config:samsungTvArtUploader.deploy.sshHost}",
				"--port", "${config:samsungTvArtUploader.deploy.sshPort}",
				"--remote-path", "${config:samsungTvArtUploader.deploy.remotePath}",
				"--restart-container", "${config:samsungTvArtUploader.deploy.container}",
				"--docker-bin", "${config:samsungTvArtUploader.deploy.dockerBin}",
				"--watch", "uploader.py", "serve.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"group": "deploy",
				"panel": "dedicated"
			}
		},
		{
			"label": "Watch & Deploy samsung-tv-art-uploader (assets — no restart)",
			"type": "process",
			"command": "python3",
			"windows": {
				"command": "python"
			},
			"args": [
				"scripts/watch_deploy.py",
				"--label", "assets",
				"--host", "${config:samsungTvArtUploader.deploy.sshHost}",
				"--port", "${config:samsungTvArtUploader.deploy.sshPort}",
				"--remote-path", "${config:samsungTvArtUploader.deploy.remotePath}",
				"--watch",
				"www/index.html", "www/favicon.png",
				"scripts/fetch_collections.sh", "scripts/aggregate_csv.py"
			],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"group": "deploy",
				"panel": "dedicated"
			}
		},
		{
			"label": "Watch & Deploy samsung-tv-art-card",
			"type": "process",
			"command": "python3",
			"windows": {
				"command": "python"
			},
			"args": [
				"scripts/watch_deploy.py",
				"--label", "card",
				"--local-dest", "${config:samsungTvArtUploader.deploy.haCardPath}",
				"--watch", "ha-card/samsung-tv-art-card.js", "ha-card/README.md",
				"--sync-dir", "ha-card/images/:images/"
			],
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"group": "deploy",
				"panel": "dedicated"
			}
		},
		{
			"label": "Sync Knowledge Base",
			"type": "process",
			"command": "${workspaceFolder:Knowledge Base}/bin/kb-sync.sh",
			"windows": {
				"command": "${config:samsungTvArtUploader.kb.bashBin}",
				"args": [
					"${workspaceFolder:Knowledge Base}/bin/kb-sync.sh"
				]
			},
			"options": {
				"cwd": "${workspaceFolder:Knowledge Base}",
				"env": {
					"RKKB_KB_SYNC_INTERVAL": "${config:samsungTvArtUploader.kb.syncInterval}"
				}
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"panel": "dedicated"
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		}
	]
}