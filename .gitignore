# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/

# Runtime data — track directory structure only; ignore generated/secret contents
data/*
!data/.gitkeep
media/*
!media/.gitkeep

# Secrets / local config
.env
samsung-tv-art.env
*.env.local

# Logs
*.log

# Editor — track .vscode/tasks.json (shared); ignore settings.json (per-machine deploy vars)
.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# Personal packaging materials (not part of the public repo)
packaging/
